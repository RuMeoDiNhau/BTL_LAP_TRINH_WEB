# Rewrite cho front controller khi truy cập trực tiếp thư mục public/.
Options -MultiViews
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # File/thư mục thật (assets, uploads, favicon...) thì phục vụ nguyên.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
